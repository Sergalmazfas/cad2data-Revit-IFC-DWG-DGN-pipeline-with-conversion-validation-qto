{
  "version": "1.0",
  "description": "DWG Template configurations for BTI projects",
  "templates": {
    "Basmanny": {
      "name": "Басманный",
      "description": "Template for Basmanny district BTI projects",
      "enabled": true,
      "insert_block": "BasmanInsert",
      "layers": {
        "WALLS": {
          "color": 7,
          "linetype": "Continuous",
          "lineweight": 0.35
        },
        "DOORS": {
          "color": 3,
          "linetype": "Continuous",
          "lineweight": 0.25
        },
        "WINDOWS": {
          "color": 5,
          "linetype": "Continuous",
          "lineweight": 0.25
        },
        "ROOMS": {
          "color": 8,
          "linetype": "Continuous",
          "lineweight": 0.18
        },
        "DIMENSIONS": {
          "color": 1,
          "linetype": "Continuous",
          "lineweight": 0.18
        },
        "TEXT": {
          "color": 7,
          "linetype": "Continuous",
          "lineweight": 0.13
        }
      },
      "text_style": {
        "font": "GOST_A",
        "height": 2.5,
        "width_factor": 0.8
      },
      "title_block": {
        "template_file": "BasmanTitleBlock.dwg",
        "attributes": {
          "PROJECT_NAME": "БТИ Басманный район",
          "SCALE": "1:100",
          "DATE": "auto",
          "AUTHOR": "BTI-DWG-QA-Pipeline"
        }
      },
      "validation_rules": {
        "required_layers": ["WALLS", "DOORS", "WINDOWS", "ROOMS"],
        "min_area": 1.0,
        "max_area": 10000.0,
        "coordinate_system": "MSK-Moscow"
      }
    },
    "Default": {
      "name": "Default BTI Template",
      "description": "Standard BTI template for general projects",
      "enabled": true,
      "insert_block": "BTIStandardInsert",
      "layers": {
        "WALLS": {"color": 7, "linetype": "Continuous", "lineweight": 0.35},
        "DOORS": {"color": 3, "linetype": "Continuous", "lineweight": 0.25},
        "WINDOWS": {"color": 5, "linetype": "Continuous", "lineweight": 0.25},
        "ROOMS": {"color": 8, "linetype": "Continuous", "lineweight": 0.18}
      },
      "text_style": {
        "font": "GOST_A",
        "height": 2.5,
        "width_factor": 0.8
      },
      "validation_rules": {
        "required_layers": ["WALLS", "DOORS", "WINDOWS"],
        "min_area": 0.1,
        "max_area": 10000.0
      }
    }
  },
  "default_template": "Basmanny"
}

